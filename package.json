{
  "name": "tmux-pro-max",
  "productName": "Tmux Pro Max",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-pane workspace for running coding agents (Claude Code, Codex, Gemini CLI, ...) side by side.",
  "main": "./out/main/index.js",
  "author": "blazespark221-byte",
  "homepage": "https://github.com/blazespark221-byte/Tmux-pro-max",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "format": "prettier --write .",
    "lint": "prettier --check . && npm run typecheck",
    "icon": "node scripts/render-icon.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
